# Copy to .env for local runs. The app loads .env at import (without
# overriding variables already exported in the shell).

# ── Storage ────────────────────────────────────────────────────────────────
# These four values must agree: compose creates the DB/user/password, and
# PG_DSN points the app at them. The defaults are for localhost only.
POSTGRES_DB=arxiv_mvp
POSTGRES_USER=arxiv
POSTGRES_PASSWORD=arxiv
POSTGRES_PORT=5432
PG_DSN=postgresql://arxiv:arxiv@localhost:5432/arxiv_mvp
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=arxiv_chunks

# ── Embeddings (OpenAI-compatible BGE-M3, 1024-d) ──────────────────────────
BGE_M3_ENDPOINT=http://localhost:8005/v1/embeddings
BGE_M3_MODEL=BAAI/bge-m3
EMBED_CONCURRENCY=2
EMBED_BATCH_SIZE=256
EMBED_TIMEOUT_S=120

# ── LLM for /ask (OpenAI-compatible chat completions) ──────────────────────
LLM_URL=http://localhost:8000/v1/chat/completions
LLM_MODEL=Qwen/Qwen3.5-4B
LLM_API_KEY=
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3

# ── Reranker ───────────────────────────────────────────────────────────────
# In-process torch model:
BGE_RERANKER_MODEL=BAAI/bge-reranker-large
BGE_RERANKER_DTYPE=fp32
# Optional: use an HTTP reranker instead (e.g. llama-server --reranking).
# RERANKER_HTTP_URL=http://localhost:8006/reranking

# ── API (used by the uvicorn command in docs, not by the app itself) ───────
API_HOST=127.0.0.1
API_PORT=8080
